{
  "manifest_version": 3,
  "name": "Tailscale Screenshot",
  "version": "0.1.0",
  "description": "Upload clipboard screenshot to your Tailscale server, get a URL back on the clipboard.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tailscale-screenshot@nexo.sh",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["clipboardRead", "clipboardWrite", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tailscale Screenshot"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Open Tailscale Screenshot"
    }
  }
}
